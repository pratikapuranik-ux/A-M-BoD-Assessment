# Settings for the board-assessment server (python server/app.py). Copy to .env and fill in; this template is safe to share.
# Keep this file private: never share, email or commit it. If a key is ever exposed, revoke it and create a new one.

# --- Option A: Claude through Microsoft Foundry (Azure) ---
# Azure key for the Foundry / Azure AI resource that has a Claude deployment. Paste after the = sign, no quotes or spaces.
ANTHROPIC_FOUNDRY_API_KEY=
# The resource name from the Azure endpoint: for https://NAME.services.ai.azure.com/... (or https://NAME.openai.azure.com/...) enter NAME.
ANTHROPIC_FOUNDRY_RESOURCE=
# Or, instead of the resource name, the full Claude endpoint, ending in /anthropic/
ANTHROPIC_FOUNDRY_BASE_URL=

# --- Option B: Claude API directly (key from console.anthropic.com, starts sk-ant-) ---
ANTHROPIC_API_KEY=

# Claude model, or the Foundry deployment name if it differs. Default: Claude Opus 5.
BOARD_MODEL=claude-opus-5

# Anonymity guardrail: self-assessment responses needed before the inside-out view is prepared (default 3).
BOARD_MIN_RESPONSES=3

# Address directors use to open survey links (e.g. https://board.example.org); blank = this server's own address.
BOARD_PUBLIC_URL=
